{
  "manifest_version": 3,
  "name": "Haivision Streamhub Controller",
  "version": "0.24.3",
  "description": "StreamHub input/output routing, existing profiles, previews and MoJo Pro RCP",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Haivision Streamhub Controller",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app.html",
        "app.css",
        "app.js",
        "encoder.js",
        "rcp-model.js",
        "preview.js",
        "scale.js",
        "polling.js",
        "logo.png",
        "features.js",
        "theme.css",
        "diagnostics.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
